mdp

module imdp1
    s : [0..8] init 0;

    [go] s = 0 -> [0.2, 0.4] : (s' = 1) + [0.1, 0.3] : (s' = 2) + [0.2, 0.5] : (s' = 3) + [0.1, 0.3] : (s' = 4) + [0.05, 0.2] : (s' = 5)  + [0.05, 0.2] : (s' = 6) + [0.05, 0.2] : (s' = 7)  + [0.05, 0.2] : (s' = 8);
    [go] s > 0 -> 1 : (s' = s);

endmodule

module imdp2
	t : [0..3] init 0;
	[go] t = 0 -> [0.3, 0.6] : (t' = 1) + [0.3, 0.5] : (t' = 2) + [0.2, 0.5] : (t' = 3);
	[go] t > 0 -> 1 : (t' = t);
	//[indep] t = 0 -> [0.4,0.5] : (t' = 1) + [0.5,0.6] : (t' = 0);
endmodule