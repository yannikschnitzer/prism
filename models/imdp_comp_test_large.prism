mdp

module imdp1
    s : [0..10] init 0;

    [go] s = 0 -> [0.04, 0.12] : (s' = 1) + [0.04, 0.08] : (s' = 2) + [0.04, 0.09] : (s' = 3) + [0.02, 0.12] : (s' = 4) + [0.05, 0.2] : (s' = 5)  + [0.05, 0.2] : (s' = 6) + [0.05, 0.2] : (s' = 7)  + [0.05, 0.2] : (s' = 8) + [0.03, 0.22] : (s' = 9) + [0.04, 0.21] : (s' = 10);
    [go] s > 0 -> 1 : (s' = s);

endmodule

module imdp2
	t : [0..10] init 0;
    [go] s = 0 -> [0.05, 0.45] : (t' = 1) + [0.05, 0.35] : (t' = 2) + [0.04, 0.24] : (t' = 3) + [0.05, 0.12] : (t' = 4) + [0.05, 0.2] : (t' = 5)  + [0.05, 0.2] : (t' = 6) + [0.03, 0.1] : (t' = 7)  + [0.05, 0.2] : (t' = 8) + [0.02, 0.21] : (t' = 9) + [0.03, 0.22] : (t' = 10);
	[go] t > 0 -> 1 : (t' = t);
	//[indep] t = 0 -> [0.4,0.5] : (t' = 1) + [0.5,0.6] : (t' = 0);
endmodule