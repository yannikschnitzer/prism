mdp

const int H = 7;
const double p;
const double q;
const double r; //= 1/2
const double eps;

const double pdiv = (1/8) * (1 - p);
const double qdiv = (1/8) * (1 - q);

module chain
	s1 : [0..H] init 0;

    //[a] true -> 1-r : (s1'=min(s1+1,H)) + r : (s1'=0);
	[a] true -> p : (s1'=min(s1+1,H)) +
	            pdiv : (s1'=max(0, s1-1)) +
	            pdiv : (s1'=max(0, s1-2)) +
	            pdiv : (s1'=max(0, s1-3)) +
	            pdiv : (s1'=max(0, s1-4)) +
	            pdiv : (s1'=max(0, s1-5)) +
	            pdiv : (s1'=max(0, s1-6)) +
	            pdiv : (s1'=max(0, s1-7)) +
	            pdiv : (s1'=0);
    [b] true -> q : (s1'=min(s1+1,H)) +
                qdiv : (s1'=max(0, s1-1)) +
                qdiv : (s1'=max(0, s1-2)) +
                qdiv : (s1'=max(0, s1-3))  +
                qdiv : (s1'=max(0, s1-4))  +
                qdiv : (s1'=max(0, s1-5))  +
                qdiv : (s1'=max(0, s1-6))  +
                qdiv : (s1'=max(0, s1-7))  +
                qdiv : (s1'=0);
endmodule

module chain2 = chain[s1 = s2] endmodule
// module chain3=chain[s1 = s3] endmodule
//module chain4=chain[s1 = s4] endmodule
//module chain5=chain[s1 = s5] endmodule

rewards
	[a] true : 1;
	[b] true : 1;
	//[c] true : 1;
endrewards

label "goal" = s1=H;
