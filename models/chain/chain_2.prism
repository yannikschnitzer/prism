mdp

const int H;
const double p;
const double q;
const double r; //= 1/2
const double eps;

module chain
	s1 : [0..H] init 0;

    [a] true -> [1-r - eps, 1-r + eps] : (s1'=min(s1+1,H)) + [r - eps, r + eps] : (s1'=0);
	[a] true -> [p - eps, p + eps] : (s1'=min(s1+1,H)) + [1-p - eps, 1-p + eps] : (s1'=0);
    [a] true -> [q - eps, q + eps] : (s1'=min(s1+1,H)) + [1-q - eps, 1-q + eps] : (s1'=0);
endmodule

module chain2 = chain[s1 = s2] endmodule
module chain3=chain[s1 = s3] endmodule
//module chain4=chain[s1 = s4] endmodule
//module chain5=chain[s1 = s5] endmodule

rewards
	[a] true : 1;
	//[b] true : 1;
	//[c] true : 1;
endrewards

label "goal" = s1=H;
