mdp

// Environment Dimensions
const int MAXX = 8;
const int MAXY = 8;
const int MAXZ = 8;

// Disturbance Probability Parameter
const double eps;
const double p; // must be less than 1/3

// Regions

// Target Region
formula target = x > MAXX - 2 & y < 2 & z > MAXZ - 2 & x2 > MAXX - 2 & y2 < 2 & z2 > MAXZ - 2;

// Obstacle Regions
formula crash = obstacle1 | obstacle2 | obstacle3 | obstacle4;
formula obstacle1 = x >= 3 & x <= 4 & z >= 1 & z <= 2;
formula obstacle2 = x >= 3 & x <= 4 & y >= 1 & y <= 2;
formula obstacle3 = x >= 3 & x <= 4 & y >= 3 & y <= 5;
formula obstacle4 = x >= 3 & x <= 4 & z >= 7 & z <= 8;

module drone
	x : [1..MAXX] init 1;
	y : [1..MAXY] init 1;
	z : [1..MAXZ] init 1;

	[front] true -> [1 - 3 * p - eps, 1 - 3 * p + eps]: (x' = min(x + 1, MAXX))
				+ [p - eps, p + eps] :(x' = min(x + 1, MAXX)) & (y' = max(y - 1,1))
				+ [p - eps, p + eps] :(x' = min(x + 1, MAXX)) & (y' = min(y + 1, MAXY))
				+ [p - eps, p + eps] :(x' = x) & (y' = max(y - 2, 1));

	[back] true -> [1 - 3 * p - eps, 1 - 3 * p + eps]: (x' = max(x - 1, 1))
				+ [p - eps, p + eps] :(x' = max(x - 1, 1)) & (y' = max(y - 1,1))
				+ [p - eps, p + eps] :(x' = max(x - 1, 1)) & (y' = min(y + 1, MAXY))
				+ [p - eps, p + eps] :(x' = x) & (y' = max(y - 2, 1));

	[right] true -> [1 - 2 * p - eps, 1 - 2 * p + eps] : (y' = min(y + 1, MAXY))
				+ [p - eps,  p + eps] : (y' = min(y + 2, MAXY))
				+ [p - eps,  p + eps] : (y' = max(y - 1, 1));

	[left] true -> [1 - 2 * p - eps, 1 - 2 * p + eps] : (y' = max(y - 1, 1))
				+ [p - eps,  p + eps] : (y' = max(y - 2, 1))
				+ [p - eps,  p + eps] : (y' = min(y + 1, MAXY));

	[up] true -> [1 - 3 * p - eps, 1 - 3 * p + eps]: (z' = min(z + 1, MAXZ))
				+ [p - eps, p + eps] :(z' = min(z + 1, MAXZ)) & (y' = max(y - 1,1))
				+ [p - eps, p + eps] :(z' = min(z + 1, MAXZ)) & (y' = min(y + 1, MAXY))
				+ [p - eps, p + eps] :(z' = z) & (y' = max(y - 2, 1));

	[down] true -> [1 - 3 * p - eps, 1 - 3 * p + eps]: (z' = max(z - 1,1))
				+ [p - eps, p + eps] :(z' = max(z - 1,1)) & (y' = max(y - 1,1))
				+ [p - eps, p + eps] :(z' = max(z - 1,1)) & (y' = min(y + 1, MAXY))
				+ [p - eps, p + eps] :(z' = z) & (y' = max(y - 2, 1));

endmodule

module drone2 = drone [ x=x2, y=y2, z=z2 ] endmodule











