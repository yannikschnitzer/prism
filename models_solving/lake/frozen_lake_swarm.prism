mdp

const int M = 10;
const int N = 10;

formula goal = 1<=r1 & r1<=2 & 2<=c1 & c1<=3 & 1<=r2 & r2<=4 & 3<=c2 & c2<=4;

module grid1
  r1 : [0..M-1] init M-1;
  c1 : [0..N-1] init 0;

  [n] r1<M-1 & c1>0 & c1<N-1 -> [0.3,0.4] : (r1'=r1+1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1-1) + [0.3,0.4] : (r1'=r1) & (c1'=c1+1);
  [n] r1<M-1 & c1=0         -> [0.3,0.4] : (r1'=r1+1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1) & (c1'=c1+1);
  [n] r1<M-1 & c1=N-1       -> [0.3,0.4] : (r1'=r1+1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1-1) + [0.3,0.4] : (r1'=r1) & (c1'=c1);
  [n] r1=M-1 & c1>0 & c1<N-1 -> [0.3,0.4] : (r1'=r1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1-1) + [0.3,0.4] : (r1'=r1) & (c1'=c1+1);
  [n] r1=M-1 & c1=0         -> [0.6,0.7] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1) & (c1'=c1+1);
  [n] r1=M-1 & c1=N-1       -> [0.6,0.7] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1) & (c1'=c1-1);

  [e] r1>0 & r1<M-1 & c1<N-1 -> [0.3,0.4] : (r1'=r1) & (c1'=c1+1) +
                             [0.3,0.4] : (r1'=r1+1) & (c1'=c1) + [0.3,0.4] : (r1'=r1-1) & (c1'=c1);
  [e] r1=0 & c1<N-1         -> [0.3,0.4] : (r1'=r1) & (c1'=c1+1) +
                             [0.3,0.4] : (r1'=r1+1) & (c1'=c1) + [0.3,0.4] : (r1'=r1) & (c1'=c1);
  [e] r1=M-1 & c1<N-1       -> [0.3,0.4] : (r1'=r1) & (c1'=c1+1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1-1) & (c1'=c1);
  [e] r1>0 & r1<M-1 & c1=N-1 -> [0.3,0.4] : (r1'=r1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1+1) & (c1'=c1) + [0.3,0.4] : (r1'=r1-1) & (c1'=c1);
  [e] r1=0 & c1=N-1         -> [0.6,0.7] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1+1) & (c1'=c1);
  [e] r1=M-1 & c1=N-1       -> [0.6,0.7] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1-1) & (c1'=c1);

  [s] r1>0 & c1>0 & c1<N-1   -> [0.3,0.4] : (r1'=r1-1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1-1) + [0.3,0.4] : (r1'=r1) & (c1'=c1+1);
  [s] r1>0 & c1=0           -> [0.3,0.4] : (r1'=r1-1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1) & (c1'=c1+1);
  [s] r1>0 & c1=N-1         -> [0.3,0.4] : (r1'=r1-1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1-1) + [0.3,0.4] : (r1'=r1) & (c1'=c1);
  [s] r1=0 & c1>0 & c1<N-1   -> [0.3,0.4] : (r1'=r1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1-1) + [0.3,0.4] : (r1'=r1) & (c1'=c1+1);
  [s] r1=0 & c1=0           -> [0.6,0.7] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1) & (c1'=c1+1);
  [s] r1=0 & c1=N-1         -> [0.6,0.7] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1) & (c1'=c1-1);

  [w] r1>0 & r1<M-1 & c1>0   -> [0.3,0.4] : (r1'=r1) & (c1'=c1-1) +
                             [0.3,0.4] : (r1'=r1+1) & (c1'=c1) + [0.3,0.4] : (r1'=r1-1) & (c1'=c1);
  [w] r1=0 & c1>0           -> [0.3,0.4] : (r1'=r1) & (c1'=c1-1) +
                             [0.3,0.4] : (r1'=r1+1) & (c1'=c1) + [0.3,0.4] : (r1'=r1) & (c1'=c1);
  [w] r1=M-1 & c1>0         -> [0.3,0.4] : (r1'=r1) & (c1'=c1-1) +
                             [0.3,0.4] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1-1) & (c1'=c1);
  [w] r1>0 & r1<M-1 & c1=0   -> [0.3,0.4] : (r1'=r1) & (c1'=c1) +
                             [0.3,0.4] : (r1'=r1+1) & (c1'=c1) + [0.3,0.4] : (r1'=r1-1) & (c1'=c1);
  [w] r1=0 & c1=0           -> [0.6,0.7] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1+1) & (c1'=c1);
  [w] r1=M-1 & c1=0         -> [0.6,0.7] : (r1'=r1) & (c1'=c1) + [0.3,0.4] : (r1'=r1-1) & (c1'=c1);
endmodule

module grid2=grid1[r1=r2,c1=c2] endmodule

rewards
  [n] true : 1;
  [e] true : 2;
  [s] true : 4;
  [w] true : 1;
endrewards
