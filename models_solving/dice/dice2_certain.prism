mdp

const double p;

module die1

	// local state
	s1 : [0..7] init 0;
	// value of the die
	d1 : [0..6] init 0;
	
	[flip] s1=0 -> p : (s1'=1) + (1-p) : (s1'=2);
	[flip] s1=1 -> p : (s1'=3) + (1-p) : (s1'=4);
	[flip] s1=2 -> p : (s1'=5) + (1-p) : (s1'=6);
	[flip] s1=3 -> p : (s1'=1) + (1-p) : (s1'=7) & (d1'=1);
	[flip] s1=4 -> p : (s1'=7) & (d1'=2) + (1-p) : (s1'=7) & (d1'=3);
	[flip] s1=5 -> p : (s1'=7) & (d1'=4) + (1-p) : (s1'=7) & (d1'=5);
	[flip] s1=6 -> p : (s1'=2) + (1-p) : (s1'=7) & (d1'=6);
	[flip] s1=7 -> (s1'=7);
	
endmodule

module die2 = die1 [ s1=s2, d1=d2 ] endmodule

rewards "coin_flips"
	[flip] !(s1=7 & s2=7) : 1;
endrewards