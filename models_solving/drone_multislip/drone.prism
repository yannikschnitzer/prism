// Environment Dimensions
const int MAXX;
const int MAXY;
const int MAXZ;

// Disturbance Probability Parameter
const double eps;
const double p; // must be less than 1/3
const double mu = 0.0001; // constant support tolerance

// Multi-Slip Constants
const int div = 9;
const double p_div = p / div;

// Regions

// Target Region
formula target = x > MAXX - 2 & y < 2 & z > MAXZ - 2 & x2 > MAXX - 2 & y2 < 2 & z2 > MAXZ - 2;

// Obstacle Regions
formula crash = obstacle1 | obstacle2 | obstacle3 | obstacle4;
formula obstacle1 = x >= 3 & x <= 4 & z >= 1 & z <= 2;
formula obstacle2 = x >= 3 & x <= 4 & y >= 1 & y <= 2;
formula obstacle3 = x >= 3 & x <= 4 & y >= 3 & y <= 5;
formula obstacle4 = x >= 3 & x <= 4 & z >= 7 & z <= 8;

formula multi_slip = x >= 1 & x <= 2 & y = 4 & (z = 3 | z = 4 | z = 5 | z = 6);
// formula multi_slip = x = 2 & y = 4 & z = 3 ;

module drone
    x : [1..MAXX] init 1;
    y : [1..MAXY] init 1;
    z : [1..MAXZ] init 1;

    [front] !multi_slip -> [max(mu,1 - 3 * p - eps),min(1 - 3 * p + eps,1-mu)]: (x' = min(x + 1, MAXX))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (x' = min(x + 1, MAXX)) & (y' = max(y - 1,1))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (x' = min(x + 1, MAXX)) & (y' = min(y + 1,MAXY))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (x' = x) & (y' = max(y - 2,1));

    [front] multi_slip -> [max(mu,1 - div * p_div - eps),min(1 - div * p_div + eps,1-mu)]: (x' = min(x + 1, MAXX))
                    + [max(mu,p_div - eps),min(p_div + eps,1-mu)]: (x' = min(x + 1, MAXX)) & (y' = max(y - 1,1))
                    + [max(mu,p_div - eps),min(p_div + eps,1-mu)]: (x' = min(x + 2, MAXX)) & (y' = max(y - 1,1))
                    + [max(mu,p_div - eps),min(p_div + eps,1-mu)]: (x' = min(x + 3, MAXX)) & (y' = max(y - 1,1))
                    + [max(mu,p_div - eps),min(p_div + eps,1-mu)]: (x' = min(x + 1, MAXX)) & (y' = max(y - 2,1))
                    + [max(mu,p_div - eps),min(p_div + eps,1-mu)]: (x' = min(x + 2, MAXX)) & (y' = max(y - 3,1))
                    + [max(mu,p_div - 0.01),min(p_div + 0.01,1-mu)]: (x' = min(x + 2, MAXX)) & (y' = max(y - 2,1))
                    + [max(mu,p_div - eps),min(p_div + eps,1-mu)]: (x' = min(x + 3, MAXX)) & (y' = max(y + 2,1))
                    + [max(mu,p_div - eps),min(p_div + eps,1-mu)]: (x' = min(x + 1, MAXX)) & (y' = min(y + 1,MAXY))
                    + [max(mu,p_div - eps),min(p_div + eps,1-mu)]: (x' = x) & (y' = max(y - 2,1));

    [back] true -> [max(mu,1 - 3 * p - eps),min(1 - 3 * p + eps,1-mu)]: (x' = max(x - 1,1))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (x' = max(x - 1,1)) & (y' = max(y - 1,1))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (x' = max(x - 1,1)) & (y' = min(y + 1,MAXY))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (x' = x) & (y' = max(y - 2,1));

    [right] true -> [max(mu,1 - 2 * p - eps),min(1 - 2 * p + eps,1-mu)]: (y' = min(y + 1,MAXY))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (y' = min(y + 2,MAXY))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (y' = max(y - 1,1));

    [left] true -> [max(mu,1 - 2 * p - eps),min(1 - 2 * p + eps,1-mu)]: (y' = max(y - 1,1))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (y' = max(y - 2,1))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (y' = min(y + 1,MAXY));

    [up] true -> [max(mu,1 - 3 * p - eps),min(1 - 3 * p + eps,1-mu)]: (z' = min(z + 1,MAXZ))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (z' = min(z + 1,MAXZ)) & (y' = max(y - 1,1))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (z' = min(z + 1,MAXZ)) & (y' = min(y + 1,MAXY))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (z' = z) & (y' = max(y - 2,1));

    [down] true -> [max(mu,1 - 3 * p - eps),min(1 - 3 * p + eps,1-mu)]: (z' = max(z - 1,1))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (z' = max(z - 1,1)) & (y' = max(y - 1,1))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (z' = max(z - 1,1)) & (y' = min(y + 1,MAXY))
                + [max(mu,p - eps),min(p + eps,1-mu)]: (z' = z) & (y' = max(y - 2,1));

endmodule

module drone2 = drone [ x=x2, y=y2, z=z2 ] endmodule