mdp
// --- Frontend reliabilities (Kfe = 6)
const double fe1; const double fe2; const double fe3;
const double fe4; const double fe5; const double fe6;
// --- App reliabilities (Kapp = 6)
const double ap1; const double ap2; const double ap3;
const double ap4; const double ap5; const double ap6;
// --- DB reliabilities (Kdb = 4)
const double db1; const double db2; const double db3; const double db4;

// Common intra-tier ‘service completes’ success (e.g., request-level success)
// You can keep these as constants or learn them too.
const double qFe;  // frontend->app success
const double qAp;  // app->db success
const double qDb;  // db->done success

// States: hub_FE=0, FE nodes 1..6, hub_AP=100, AP nodes 101..106,
// hub_DB=200, DB nodes 201..204, FAIL=900, DONE=999.
module web
  s : [0..999] init 0;

  // --- Tier 1: load balancer chooses a FE node (Kfe distinct params) ---
  [choose_fe] s=0 ->
      fe1:(s'=1)+fe2:(s'=2)+fe3:(s'=3)+fe4:(s'=4)+fe5:(s'=5)+fe6:(s'=6)
    + (1-(fe1+fe2+fe3+fe4+fe5+fe6)):(s'=900);

  // identical FE continuation (bisim merges 1..6)
  [fe_run] s>=1 & s<=6 -> qFe:(s'=100) + (1-qFe):(s'=900);

  // --- Tier 2: choose app server (Kapp distinct params) ---
  [choose_ap] s=100 ->
      ap1:(s'=101)+ap2:(s'=102)+ap3:(s'=103)+ap4:(s'=104)+ap5:(s'=105)+ap6:(s'=106)
    + (1-(ap1+ap2+ap3+ap4+ap5+ap6)):(s'=900);

  // identical app continuation
  [ap_run] s>=101 & s<=106 -> qAp:(s'=200) + (1-qAp):(s'=900);

  // --- Tier 3: choose DB shard (Kdb distinct params) ---
  [choose_db] s=200 ->
      db1:(s'=201)+db2:(s'=202)+db3:(s'=203)+db4:(s'=204)
    + (1-(db1+db2+db3+db4)):(s'=900);

  // identical DB continuation
  [db_run] s>=201 & s<=204 -> qDb:(s'=999) + (1-qDb):(s'=900);

  [] s=900 -> (s'=900);  // fail sink
  [] s=999 -> (s'=999);  // success sink
endmodule

label "goal" = s=999;
// e.g., Pmax=? [ F "goal" ]