const double p;
const double q;
const double r;

module Asym
  s : [0..5] init 0;

  // ---------- Action A: exposes p^2 and p*q ----------
  //   Tight CP intervals will be learned on both (by sampling A only).
  //   Remainder 1 - p^2 - p*q is constrained by normalization.
  [stepA] s=0 -> p*p:(s'=1) + p*q:(s'=2) + (1 - p*p - p*q):(s'=3);

  // ---------- Action B: ONLY q*(1-p) appears ----------
  //   No direct samples on q*(1-p) -> wide interval under plain IMDP.
  [stepB] s=0 -> q*(1-p):(s'=1) + (1 - q*(1-p)):(s'=3);

  // identical processing: succeed with r, else loop
  [proc] s=1 -> r:(s'=4) + (1-r):(s'=1);
  [proc] s=2 -> r:(s'=4) + (1-r):(s'=2);

  // absorbing
  [] s=3 -> (s'=3);
  [] s=4 -> (s'=4);
endmodule

label "done" = s=4;
label "drop" = s=3;