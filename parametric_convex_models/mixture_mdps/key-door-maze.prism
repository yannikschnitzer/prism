mdp

// ===== GRID & SITES =====
const int M = 20;                 // width  (0..M-1)
const int N = 20;                 // height (0..N-1)
const int Gx = 19;                // goal x
const int Gy = 19;                // goal y
const int Kx = 8;                 // key x
const int Ky = 3;                 // key y

// ===== MIXTURE WEIGHTS (K=3) =====
const double theta1;
const double theta2;
formula theta3 = 1 - theta1 - theta2;

// ===== BASE REGIME DRIFTS (per mode; each sum < 1) =====
// mode 1: east-ish
const double de1 = 0.18;
const double dw1 = 0.08;
const double dn1 = 0.12;
const double ds1 = 0.12; // sum 0.50
// mode 2: west-ish
const double de2 = 0.10;
const double dw2 = 0.20;
const double dn2 = 0.10;
const double ds2 = 0.10; // sum 0.50
// mode 3: north-ish
const double de3 = 0.12;
const double dw3 = 0.10;
const double dn3 = 0.18;
const double ds3 = 0.08; // sum 0.48

// mixture-combined base drift (affine in θ)
formula pE0 = theta1*de1 + theta2*de2 + theta3*de3;
formula pW0 = theta1*dw1 + theta2*dw2 + theta3*dw3;
formula pN0 = theta1*dn1 + theta2*dn2 + theta3*dn3;
formula pS0 = theta1*ds1 + theta2*ds2 + theta3*ds3;

// ===== NORMAL ZONE MULTIPLIERS (by x; keep max ≤ ~1.6 so sum drift ≤ ~0.8) =====
// Left zone  x ∈ [0..6]    : east corridor
const double aEL = 1.6;
const double aWL = 0.8;
const double aNL = 0.8;
const double aSL = 0.8;
// Centre     x ∈ [7..12]   : east wind tunnel
const double aEC = 1.5;
const double aWC = 0.7;
const double aNC = 0.7;
const double aSC = 0.7;
// Right zone x ∈ [13..19]  : west corridor
const double aER = 0.7;
const double aWR = 1.6;
const double aNR = 0.8;
const double aSR = 0.8;

// ===== STORM REGIONS (rectangles) =====
formula inS1 = (x>=4  & x<=7  & y>=6  & y<=10);   // Storm 1: pushes West/South
formula inS2 = (x>=10 & x<=12 & y>=3  & y<=5 );   // Storm 2: pushes East/North
formula inS3 = (x>=14 & x<=18 & y>=12 & y<=16);   // Storm 3: pushes East/South
formula inStorm = inS1 | inS2 | inS3;

// ===== STORM MULTIPLIERS (≤~1.8 so total drift stays < 1) =====
// S1: strong West/South, weak East/North
const double s1E = 0.7;
const double s1W = 1.8;
const double s1N = 0.7;
const double s1S = 1.6;
// S2: strong East/North, weak West/South
const double s2E = 1.6;
const double s2W = 0.7;
const double s2N = 1.8;
const double s2S = 0.6;
// S3: strong East/South, weak West/North
const double s3E = 1.8;
const double s3W = 0.6;
const double s3N = 0.8;
const double s3S = 1.5;

// ===== STATE =====
module maze
  x : [0..M-1] init 0;
  y : [0..N-1] init 0;
  hasKey : [0..1] init 0;

  // pick up key explicitly (scheduler can choose this when on key cell)
  [pickup] (x=Kx & y=Ky & hasKey=0) -> (hasKey'=1) & (x'=x) & (y'=y);

  // ---------- NORTH (y -> max(y-1,0)) ----------
  // Storm first (disjoint guards), then normal zones
  [north] inS1 ->
     s1E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s1W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s1N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s1S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s1E*pE0 + s1W*pW0 + s1N*pN0 + s1S*pS0)) : (x'=x) & (y'=max(y-1,0));

  [north] inS2 ->
     s2E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s2W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s2N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s2S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s2E*pE0 + s2W*pW0 + s2N*pN0 + s2S*pS0)) : (x'=x) & (y'=max(y-1,0));

  [north] inS3 ->
     s3E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s3W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s3N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s3S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s3E*pE0 + s3W*pW0 + s3N*pN0 + s3S*pS0)) : (x'=x) & (y'=max(y-1,0));

  [north] !inStorm & x<=6 ->
     aEL*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWL*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNL*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSL*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aEL*pE0 + aWL*pW0 + aNL*pN0 + aSL*pS0)) : (x'=x) & (y'=max(y-1,0));

  [north] !inStorm & x>=7 & x<=12 ->
     aEC*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWC*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNC*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSC*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aEC*pE0 + aWC*pW0 + aNC*pN0 + aSC*pS0)) : (x'=x) & (y'=max(y-1,0));

  [north] !inStorm & x>=13 ->
     aER*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWR*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNR*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSR*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aER*pE0 + aWR*pW0 + aNR*pN0 + aSR*pS0)) : (x'=x) & (y'=max(y-1,0));

  // ---------- SOUTH (y -> min(y+1,N-1)) ----------
  [south] inS1 ->
     s1E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s1W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s1N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s1S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s1E*pE0 + s1W*pW0 + s1N*pN0 + s1S*pS0)) : (x'=x) & (y'=min(y+1,N-1));

  [south] inS2 ->
     s2E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s2W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s2N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s2S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s2E*pE0 + s2W*pW0 + s2N*pN0 + s2S*pS0)) : (x'=x) & (y'=min(y+1,N-1));

  [south] inS3 ->
     s3E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s3W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s3N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s3S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s3E*pE0 + s3W*pW0 + s3N*pN0 + s3S*pS0)) : (x'=x) & (y'=min(y+1,N-1));

  [south] !inStorm & x<=6 ->
     aEL*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWL*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNL*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSL*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aEL*pE0 + aWL*pW0 + aNL*pN0 + aSL*pS0)) : (x'=x) & (y'=min(y+1,N-1));

  [south] !inStorm & x>=7 & x<=12 ->
     aEC*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWC*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNC*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSC*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aEC*pE0 + aWC*pW0 + aNC*pN0 + aSC*pS0)) : (x'=x) & (y'=min(y+1,N-1));

  [south] !inStorm & x>=13 ->
     aER*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWR*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNR*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSR*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aER*pE0 + aWR*pW0 + aNR*pN0 + aSR*pS0)) : (x'=x) & (y'=min(y+1,N-1));

  // ---------- EAST (x -> min(x+1,M-1)) ----------
  [east] inS1 ->
     s1E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s1W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s1N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s1S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s1E*pE0 + s1W*pW0 + s1N*pN0 + s1S*pS0)) : (x'=min(x+1,M-1)) & (y'=y);

  [east] inS2 ->
     s2E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s2W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s2N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s2S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s2E*pE0 + s2W*pW0 + s2N*pN0 + s2S*pS0)) : (x'=min(x+1,M-1)) & (y'=y);

  [east] inS3 ->
     s3E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s3W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s3N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s3S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s3E*pE0 + s3W*pW0 + s3N*pN0 + s3S*pS0)) : (x'=min(x+1,M-1)) & (y'=y);

  [east] !inStorm & x<=6 ->
     aEL*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWL*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNL*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSL*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aEL*pE0 + aWL*pW0 + aNL*pN0 + aSL*pS0)) : (x'=min(x+1,M-1)) & (y'=y);

  [east] !inStorm & x>=7 & x<=12 ->
     aEC*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWC*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNC*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSC*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aEC*pE0 + aWC*pW0 + aNC*pN0 + aSC*pS0)) : (x'=min(x+1,M-1)) & (y'=y);

  [east] !inStorm & x>=13 ->
     aER*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWR*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNR*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSR*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aER*pE0 + aWR*pW0 + aNR*pN0 + aSR*pS0)) : (x'=min(x+1,M-1)) & (y'=y);

  // ---------- WEST (x -> max(x-1,0)) ----------
  [west] inS1 ->
     s1E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s1W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s1N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s1S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s1E*pE0 + s1W*pW0 + s1N*pN0 + s1S*pS0)) : (x'=max(x-1,0)) & (y'=y);

  [west] inS2 ->
     s2E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s2W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s2N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s2S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s2E*pE0 + s2W*pW0 + s2N*pN0 + s2S*pS0)) : (x'=max(x-1,0)) & (y'=y);

  [west] inS3 ->
     s3E*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     s3W*pW0 : (x'=max(x-1,0))   & (y'=y) +
     s3N*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     s3S*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (s3E*pE0 + s3W*pW0 + s3N*pN0 + s3S*pS0)) : (x'=max(x-1,0)) & (y'=y);

  [west] !inStorm & x<=6 ->
     aEL*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWL*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNL*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSL*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aEL*pE0 + aWL*pW0 + aNL*pN0 + aSL*pS0)) : (x'=max(x-1,0)) & (y'=y);

  [west] !inStorm & x>=7 & x<=12 ->
     aEC*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWC*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNC*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSC*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aEC*pE0 + aWC*pW0 + aNC*pN0 + aSC*pS0)) : (x'=max(x-1,0)) & (y'=y);

  [west] !inStorm & x>=13 ->
     aER*pE0 : (x'=min(x+1,M-1)) & (y'=y) +
     aWR*pW0 : (x'=max(x-1,0))   & (y'=y) +
     aNR*pN0 : (x'=x)            & (y'=max(y-1,0)) +
     aSR*pS0 : (x'=x)            & (y'=min(y+1,N-1)) +
     (1 - (aER*pE0 + aWR*pW0 + aNR*pN0 + aSR*pS0)) : (x'=max(x-1,0)) & (y'=y);
endmodule

// ===== Labels =====
label "goal" = (x = Gx & y = Gy & hasKey = 1);
label "storm" = inStorm;

// ===== Rewards =====
// per-step time cost until goal
rewards "steps"
  (x != Gx | y != Gy | hasKey = 0) : 1;
  inStorm & !(x = Gx & y = Gy & hasKey = 1) : 50;
endrewards