mdp

// --- grid + goal (no wrapping) ---
const int M = 10;                 // width  (0..M-1)
const int N = 10;                 // height (0..N-1)
const int Gx = 9;                 // goal x
const int Gy = 9;                 // goal y

// --- mixture weights ---
const double theta1;              // pass via -const (e.g., theta1=0.3, theta2=0.4)
const double theta2;
formula theta3 = 1 - theta1 - theta2;

// --- regime drift parameters (choose so sums stay <= 1) ---
const double de1 = 0.22;  const double dw1 = 0.11;  const double dn1 = 0.08;  const double ds1 = 0.13; // sum = 0.54
const double de2 = 0.27;  const double dw2 = 0.06;  const double dn2 = 0.15;  const double ds2 = 0.04; // sum = 0.52
const double de3 = 0.09;  const double dw3 = 0.29;  const double dn3 = 0.05;  const double ds3 = 0.17; // sum = 0.60

// mixture drift probabilities (affine in theta)
formula pE = theta1*de1 + theta2*de2 + theta3*de3; // drift East
formula pW = theta1*dw1 + theta2*dw2 + theta3*dw3; // drift West
formula pN = theta1*dn1 + theta2*dn2 + theta3*dn3; // drift North
formula pS = theta1*ds1 + theta2*ds2 + theta3*ds3; // drift South
formula pI = 1 - (pE + pW + pN + pS);              // intended move  (ensure >=0)

// ---- costs & resources ----
const double dash_cost = 0.5;     // extra cost when using a dash action
const double wait_cost = 0.1;     // small cost for waiting (optional)
const double storm_cost = 2.0;    // per-step penalty in storm zone
const double lava_cost = 50.0;    // per-step penalty in lava (absorbing)
const int EMAX = 4;               // dash energy budget

// ---- hazard zones (rectangles; tweak to taste) ----
formula in_storm =
   (x>=3 & x<=6 & y>=3 & y<=6)      // central storm block
 | (x>=1 & x<=2 & y>=6 & y<=8);     // second storm strip

formula in_lava =
   (x>=4 & x<=5 & y>=4 & y<=5)      // central 2x2 lava
 | (x>=7 & x<=8 & y>=2 & y<=3);     // another small lava

module grid
  // agent position; start at (0,0)
  x : [0..M-1] init 0;
  y : [0..N-1] init 0;
  // dash energy
  e : [0..EMAX] init EMAX;

  // ---------- regular moves (1 cell intended) ----------
  [north] true ->
     pE : (x' = min(x+1, M-1)) & (y' = y) +
     pW : (x' = max(x-1, 0))   & (y' = y) +
     pN : (x' = x)             & (y' = max(y-1, 0)) +
     pS : (x' = x)             & (y' = min(y+1, N-1)) +
     pI : (x' = x)             & (y' = max(y-1, 0)) & (e' = e);

  [south] true  ->
     pE : (x' = min(x+1, M-1)) & (y' = y) +
     pW : (x' = max(x-1, 0))   & (y' = y) +
     pN : (x' = x)             & (y' = max(y-1, 0)) +
     pS : (x' = x)             & (y' = min(y+1, N-1)) +
     pI : (x' = x)             & (y' = min(y+1, N-1)) & (e' = e);

  [east] true ->
     pE : (x' = min(x+1, M-1)) & (y' = y) +
     pW : (x' = max(x-1, 0))   & (y' = y) +
     pN : (x' = x)             & (y' = max(y-1, 0)) +
     pS : (x' = x)             & (y' = min(y+1, N-1)) +
     pI : (x' = min(x+1, M-1)) & (y' = y)           & (e' = e);

  [west] true ->
     pE : (x' = min(x+1, M-1)) & (y' = y) +
     pW : (x' = max(x-1, 0))   & (y' = y) +
     pN : (x' = x)             & (y' = max(y-1, 0)) +
     pS : (x' = x)             & (y' = min(y+1, N-1)) +
     pI : (x' = max(x-1, 0))   & (y' = y)           & (e' = e);

  // ---------- dash moves (2 cells intended; consume energy) ----------
  [dash_north]  e>0 ->
     pE : (x' = min(x+1, M-1)) & (y' = y) +
     pW : (x' = max(x-1, 0))   & (y' = y) +
     pN : (x' = x)             & (y' = max(y-1, 0)) +
     pS : (x' = x)             & (y' = min(y+1, N-1)) +
     pI : (x' = x)             & (y' = max(y-2, 0)) & (e' = e-1);

  [dash_east] e > 0 ->
     pE : (x' = min(x+1, M-1)) & (y' = y) +
     pW : (x' = max(x-1, 0))   & (y' = y) +
     pN : (x' = x)             & (y' = max(y-1, 0)) +
     pS : (x' = x)             & (y' = min(y+1, N-1)) +
     pI : (x' = min(x+2, M-1)) & (y' = y)           & (e' = e-1);

  // ---------- wait (absorbs drift only; sometimes wise near hazards) ----------
  [wait] true ->
     pE : (x' = min(x+1, M-1)) & (y' = y) +
     pW : (x' = max(x-1, 0))   & (y' = y) +
     pN : (x' = x)             & (y' = max(y-1, 0)) +
     pS : (x' = x)             & (y' = min(y+1, N-1)) +
     pI : (x' = x)             & (y' = y)           & (e' = e);
endmodule

label "goal" = (x = Gx & y = Gy);
label "lava" = in_lava;

// ---------- rewards ----------
// per-step cost until goal; storm adds penalty; lava is very bad
rewards "total_cost"
  (x != Gx | y != Gy) & in_storm : 1 + storm_cost;
  (x != Gx | y != Gy) & !in_storm : 1;
  [dash_north] true : dash_cost;
  [dash_east]  true : dash_cost;
  [wait]       true : wait_cost;
  // in lava (absorbing): big per-step penalty to reflect failure
  (x = x) & in_lava : lava_cost;
endrewards