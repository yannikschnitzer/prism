const double dA95 = 0.089;
const double uA96 = 0.127;
const double dA96 = 0.087;
const double uA97 = 0.125;
const double dA97 = 0.085;
const double uA98 = 0.124;
const double dA98 = 0.083;
const double uA99 = 0.122;
const double dA99 = 0.082;
const double uA100 = 0.120;
const double dA100 = 0.080;

// ===== Mixture-combined (affine in θ) =====
formula pU_L0 = theta1*uL1 + theta2*uL2 + theta3*uL3 + theta4*uL4 + theta5*uL5 + theta6*uL6 + theta7*uL7 + theta8*uL8 + theta9*uL9 + theta10*uL10 + theta11*uL11 + theta12*uL12 + theta13*uL13 + theta14*uL14 + theta15*uL15 + theta16*uL16 + theta17*uL17 + theta18*uL18 + theta19*uL19 + theta20*uL20 + theta21*uL21 + theta22*uL22 + theta23*uL23 + theta24*uL24 + theta25*uL25 + theta26*uL26 + theta27*uL27 + theta28*uL28 + theta29*uL29 + theta30*uL30 + theta31*uL31 + theta32*uL32 + theta33*uL33 + theta34*uL34 + theta35*uL35 + theta36*uL36 + theta37*uL37 + theta38*uL38 + theta39*uL39 + theta40*uL40 + theta41*uL41 + theta42*uL42 + theta43*uL43 + theta44*uL44 + theta45*uL45 + theta46*uL46 + theta47*uL47 + theta48*uL48 + theta49*uL49 + theta50*uL50 + theta51*uL51 + theta52*uL52 + theta53*uL53 + theta54*uL54 + theta55*uL55 + theta56*uL56 + theta57*uL57 + theta58*uL58 + theta59*uL59 + theta60*uL60 + theta61*uL61 + theta62*uL62 + theta63*uL63 + theta64*uL64 + theta65*uL65 + theta66*uL66 + theta67*uL67 + theta68*uL68 + theta69*uL69 + theta70*uL70 + theta71*uL71 + theta72*uL72 + theta73*uL73 + theta74*uL74 + theta75*uL75 + theta76*uL76 + theta77*uL77 + theta78*uL78 + theta79*uL79 + theta80*uL80 + theta81*uL81 + theta82*uL82 + theta83*uL83 + theta84*uL84 + theta85*uL85 + theta86*uL86 + theta87*uL87 + theta88*uL88 + theta89*uL89 + theta90*uL90 + theta91*uL91 + theta92*uL92 + theta93*uL93 + theta94*uL94 + theta95*uL95 + theta96*uL96 + theta97*uL97 + theta98*uL98 + theta99*uL99 + theta100*uL100;
formula pD_L0 = theta1*dL1 + theta2*dL2 + theta3*dL3 + theta4*dL4 + theta5*dL5 + theta6*dL6 + theta7*dL7 + theta8*dL8 + theta9*dL9 + theta10*dL10 + theta11*dL11 + theta12*dL12 + theta13*dL13 + theta14*dL14 + theta15*dL15 + theta16*dL16 + theta17*dL17 + theta18*dL18 + theta19*dL19 + theta20*dL20 + theta21*dL21 + theta22*dL22 + theta23*dL23 + theta24*dL24 + theta25*dL25 + theta26*dL26 + theta27*dL27 + theta28*dL28 + theta29*dL29 + theta30*dL30 + theta31*dL31 + theta32*dL32 + theta33*dL33 + theta34*dL34 + theta35*dL35 + theta36*dL36 + theta37*dL37 + theta38*dL38 + theta39*dL39 + theta40*dL40 + theta41*dL41 + theta42*dL42 + theta43*dL43 + theta44*dL44 + theta45*dL45 + theta46*dL46 + theta47*dL47 + theta48*dL48 + theta49*dL49 + theta50*dL50 + theta51*dL51 + theta52*dL52 + theta53*dL53 + theta54*dL54 + theta55*dL55 + theta56*dL56 + theta57*dL57 + theta58*dL58 + theta59*dL59 + theta60*dL60 + theta61*dL61 + theta62*dL62 + theta63*dL63 + theta64*dL64 + theta65*dL65 + theta66*dL66 + theta67*dL67 + theta68*dL68 + theta69*dL69 + theta70*dL70 + theta71*dL71 + theta72*dL72 + theta73*dL73 + theta74*dL74 + theta75*dL75 + theta76*dL76 + theta77*dL77 + theta78*dL78 + theta79*dL79 + theta80*dL80 + theta81*dL81 + theta82*dL82 + theta83*dL83 + theta84*dL84 + theta85*dL85 + theta86*dL86 + theta87*dL87 + theta88*dL88 + theta89*dL89 + theta90*dL90 + theta91*dL91 + theta92*dL92 + theta93*dL93 + theta94*dL94 + theta95*dL95 + theta96*dL96 + theta97*dL97 + theta98*dL98 + theta99*dL99 + theta100*dL100;

formula pU_M0 = theta1*uM1 + theta2*uM2 + theta3*uM3 + theta4*uM4 + theta5*uM5 + theta6*uM6 + theta7*uM7 + theta8*uM8 + theta9*uM9 + theta10*uM10 + theta11*uM11 + theta12*uM12 + theta13*uM13 + theta14*uM14 + theta15*uM15 + theta16*uM16 + theta17*uM17 + theta18*uM18 + theta19*uM19 + theta20*uM20 + theta21*uM21 + theta22*uM22 + theta23*uM23 + theta24*uM24 + theta25*uM25 + theta26*uM26 + theta27*uM27 + theta28*uM28 + theta29*uM29 + theta30*uM30 + theta31*uM31 + theta32*uM32 + theta33*uM33 + theta34*uM34 + theta35*uM35 + theta36*uM36 + theta37*uM37 + theta38*uM38 + theta39*uM39 + theta40*uM40 + theta41*uM41 + theta42*uM42 + theta43*uM43 + theta44*uM44 + theta45*uM45 + theta46*uM46 + theta47*uM47 + theta48*uM48 + theta49*uM49 + theta50*uM50 + theta51*uM51 + theta52*uM52 + theta53*uM53 + theta54*uM54 + theta55*uM55 + theta56*uM56 + theta57*uM57 + theta58*uM58 + theta59*uM59 + theta60*uM60 + theta61*uM61 + theta62*uM62 + theta63*uM63 + theta64*uM64 + theta65*uM65 + theta66*uM66 + theta67*uM67 + theta68*uM68 + theta69*uM69 + theta70*uM70 + theta71*uM71 + theta72*uM72 + theta73*uM73 + theta74*uM74 + theta75*uM75 + theta76*uM76 + theta77*uM77 + theta78*uM78 + theta79*uM79 + theta80*uM80 + theta81*uM81 + theta82*uM82 + theta83*uM83 + theta84*uM84 + theta85*uM85 + theta86*uM86 + theta87*uM87 + theta88*uM88 + theta89*uM89 + theta90*uM90 + theta91*uM91 + theta92*uM92 + theta93*uM93 + theta94*uM94 + theta95*uM95 + theta96*uM96 + theta97*uM97 + theta98*uM98 + theta99*uM99 + theta100*uM100;
formula pD_M0 = theta1*dM1 + theta2*dM2 + theta3*dM3 + theta4*dM4 + theta5*dM5 + theta6*dM6 + theta7*dM7 + theta8*dM8 + theta9*dM9 + theta10*dM10 + theta11*dM11 + theta12*dM12 + theta13*dM13 + theta14*dM14 + theta15*dM15 + theta16*dM16 + theta17*dM17 + theta18*dM18 + theta19*dM19 + theta20*dM20 + theta21*dM21 + theta22*dM22 + theta23*dM23 + theta24*dM24 + theta25*dM25 + theta26*dM26 + theta27*dM27 + theta28*dM28 + theta29*dM29 + theta30*dM30 + theta31*dM31 + theta32*dM32 + theta33*dM33 + theta34*dM34 + theta35*dM35 + theta36*dM36 + theta37*dM37 + theta38*dM38 + theta39*dM39 + theta40*dM40 + theta41*dM41 + theta42*dM42 + theta43*dM43 + theta44*dM44 + theta45*dM45 + theta46*dM46 + theta47*dM47 + theta48*dM48 + theta49*dM49 + theta50*dM50 + theta51*dM51 + theta52*dM52 + theta53*dM53 + theta54*dM54 + theta55*dM55 + theta56*dM56 + theta57*dM57 + theta58*dM58 + theta59*dM59 + theta60*dM60 + theta61*dM61 + theta62*dM62 + theta63*dM63 + theta64*dM64 + theta65*dM65 + theta66*dM66 + theta67*dM67 + theta68*dM68 + theta69*dM69 + theta70*dM70 + theta71*dM71 + theta72*dM72 + theta73*dM73 + theta74*dM74 + theta75*dM75 + theta76*dM76 + theta77*dM77 + theta78*dM78 + theta79*dM79 + theta80*dM80 + theta81*dM81 + theta82*dM82 + theta83*dM83 + theta84*dM84 + theta85*dM85 + theta86*dM86 + theta87*dM87 + theta88*dM88 + theta89*dM89 + theta90*dM90 + theta91*dM91 + theta92*dM92 + theta93*dM93 + theta94*dM94 + theta95*dM95 + theta96*dM96 + theta97*dM97 + theta98*dM98 + theta99*dM99 + theta100*dM100;

formula pU_A0 = theta1*uA1 + theta2*uA2 + theta3*uA3 + theta4*uA4 + theta5*uA5 + theta6*uA6 + theta7*uA7 + theta8*uA8 + theta9*uA9 + theta10*uA10 + theta11*uA11 + theta12*uA12 + theta13*uA13 + theta14*uA14 + theta15*uA15 + theta16*uA16 + theta17*uA17 + theta18*uA18 + theta19*uA19 + theta20*uA20 + theta21*uA21 + theta22*uA22 + theta23*uA23 + theta24*uA24 + theta25*uA25 + theta26*uA26 + theta27*uA27 + theta28*uA28 + theta29*uA29 + theta30*uA30 + theta31*uA31 + theta32*uA32 + theta33*uA33 + theta34*uA34 + theta35*uA35 + theta36*uA36 + theta37*uA37 + theta38*uA38 + theta39*uA39 + theta40*uA40 + theta41*uA41 + theta42*uA42 + theta43*uA43 + theta44*uA44 + theta45*uA45 + theta46*uA46 + theta47*uA47 + theta48*uA48 + theta49*uA49 + theta50*uA50 + theta51*uA51 + theta52*uA52 + theta53*uA53 + theta54*uA54 + theta55*uA55 + theta56*uA56 + theta57*uA57 + theta58*uA58 + theta59*uA59 + theta60*uA60 + theta61*uA61 + theta62*uA62 + theta63*uA63 + theta64*uA64 + theta65*uA65 + theta66*uA66 + theta67*uA67 + theta68*uA68 + theta69*uA69 + theta70*uA70 + theta71*uA71 + theta72*uA72 + theta73*uA73 + theta74*uA74 + theta75*uA75 + theta76*uA76 + theta77*uA77 + theta78*uA78 + theta79*uA79 + theta80*uA80 + theta81*uA81 + theta82*uA82 + theta83*uA83 + theta84*uA84 + theta85*uA85 + theta86*uA86 + theta87*uA87 + theta88*uA88 + theta89*uA89 + theta90*uA90 + theta91*uA91 + theta92*uA92 + theta93*uA93 + theta94*uA94 + theta95*uA95 + theta96*uA96 + theta97*uA97 + theta98*uA98 + theta99*uA99 + theta100*uA100;
formula pD_A0 = theta1*dA1 + theta2*dA2 + theta3*dA3 + theta4*dA4 + theta5*dA5 + theta6*dA6 + theta7*dA7 + theta8*dA8 + theta9*dA9 + theta10*dA10 + theta11*dA11 + theta12*dA12 + theta13*dA13 + theta14*dA14 + theta15*dA15 + theta16*dA16 + theta17*dA17 + theta18*dA18 + theta19*dA19 + theta20*dA20 + theta21*dA21 + theta22*dA22 + theta23*dA23 + theta24*dA24 + theta25*dA25 + theta26*dA26 + theta27*dA27 + theta28*dA28 + theta29*dA29 + theta30*dA30 + theta31*dA31 + theta32*dA32 + theta33*dA33 + theta34*dA34 + theta35*dA35 + theta36*dA36 + theta37*dA37 + theta38*dA38 + theta39*dA39 + theta40*dA40 + theta41*dA41 + theta42*dA42 + theta43*dA43 + theta44*dA44 + theta45*dA45 + theta46*dA46 + theta47*dA47 + theta48*dA48 + theta49*dA49 + theta50*dA50 + theta51*dA51 + theta52*dA52 + theta53*dA53 + theta54*dA54 + theta55*dA55 + theta56*dA56 + theta57*dA57 + theta58*dA58 + theta59*dA59 + theta60*dA60 + theta61*dA61 + theta62*dA62 + theta63*dA63 + theta64*dA64 + theta65*dA65 + theta66*dA66 + theta67*dA67 + theta68*dA68 + theta69*dA69 + theta70*dA70 + theta71*dA71 + theta72*dA72 + theta73*dA73 + theta74*dA74 + theta75*dA75 + theta76*dA76 + theta77*dA77 + theta78*dA78 + theta79*dA79 + theta80*dA80 + theta81*dA81 + theta82*dA82 + theta83*dA83 + theta84*dA84 + theta85*dA85 + theta86*dA86 + theta87*dA87 + theta88*dA88 + theta89*dA89 + theta90*dA90 + theta91*dA91 + theta92*dA92 + theta93*dA93 + theta94*dA94 + theta95*dA95 + theta96*dA96 + theta97*dA97 + theta98*dA98 + theta99*dA99 + theta100*dA100;

// ===== State-dependent structure =====
formula zCOLD = (e <= 3);
formula zWARM = (e >= 4 & e <= L-3);
formula zHOT  = (e >= L-2 & e < L);

// "last action" codes and cooldown (to penalize repeated/too-frequent aggressive)
const int A_NONE = 0;
const int A_LIGHT = 1;
const int A_MED   = 2;
const int A_AGGR  = 3;

const int CMAX = 2;   // cooldown memory (0..CMAX)

// Repetition multipliers (fatigue if repeating same action)
const double repL = 0.90;
const double repM = 0.90;
const double repA = 0.80;

// Cooldown multiplier for AGGRESSIVE if cooldown < CMAX steps
const double coolA = 0.70;

// Zone multipliers (<=~1.2; keep sums < 1 comfortably)
const double mUL_cold = 1.15;
const double mDL_cold = 0.90;
const double mUM_cold = 1.05;
const double mDM_cold = 0.95;
const double mUA_cold = 1.00;
const double mDA_cold = 1.10;

const double mUL_warm = 1.00;
const double mDL_warm = 1.00;
const double mUM_warm = 1.15;
const double mDM_warm = 0.95;
const double mUA_warm = 1.05;
const double mDA_warm = 1.05;

const double mUL_hot = 0.85;
const double mDL_hot = 1.05;
const double mUM_hot = 1.00;
const double mDM_hot = 1.00;
const double mUA_hot = 1.10;
const double mDA_hot = 0.95;

// Small additive nudges by zone (constant, independent of θ)
// (kept small so pU+pD<=1 always)
const double dUL_cold = 0.02;
const double dDL_cold = 0.00;
const double dUM_cold = 0.01;
const double dDM_cold = 0.00;
const double dUA_cold = 0.00;
const double dDA_cold = 0.02;

const double dUL_warm = 0.00;
const double dDL_warm = 0.00;
const double dUM_warm = 0.02;
const double dDM_warm = 0.00;
const double dUA_warm = 0.01;
const double dDA_warm = 0.01;

const double dUL_hot = -0.02;
const double dDL_hot = 0.00;
const double dUM_hot = 0.00;
const double dDM_hot = 0.00;
const double dUA_hot = 0.01;
const double dDA_hot = -0.01;

// ===== Costs =====
const double cost_light = 0.05;
const double cost_med   = 0.10;
const double cost_aggr  = 0.30;
const double time_cost  = 1.0;
const double churn_pen  = 5.0;

// ===== State =====
module engage
  e     : [0..L] init 2;              // engagement level
  last  : [0..3] init A_NONE;         // last action taken
  cool  : [0..CMAX] init CMAX;        // steps since AGGRESSIVE (cap at CMAX)

  // terminals
  [] (e=0) -> (e'=e) & (last'=last) & (cool'=cool);
  [] (e=L) -> (e'=e) & (last'=last) & (cool'=cool);

  // ---------- LIGHT ----------
  // cold zone, not repeating LIGHT
  [light] e>0 & e<L & zCOLD & !(last = A_LIGHT) ->
     (mUL_cold*pU_L0 + dUL_cold) : (e' = min(e+1,L)) & (last' = A_LIGHT) & (cool' = min(cool+1,CMAX)) +
     (mDL_cold*pD_L0 + dDL_cold) : (e' = max(e-1,0)) & (last' = A_LIGHT) & (cool' = min(cool+1,CMAX)) +
     (1 - (mUL_cold*pU_L0 + dUL_cold) - (mDL_cold*pD_L0 + dDL_cold)) : (e' = e) & (last' = A_LIGHT) & (cool' = min(cool+1,CMAX));

  // cold zone, repeating LIGHT (fatigue)
  [light] e>0 & e<L & zCOLD & (last = A_LIGHT) ->
     (repL*mUL_cold*pU_L0 + dUL_cold) : (e' = min(e+1,L)) & (last' = A_LIGHT) & (cool' = min(cool+1,CMAX)) +
     (repL*mDL_cold*pD_L0 + dDL_cold) : (e' = max(e-1,0)) & (last' = A_LIGHT) & (cool' = min(cool+1,CMAX)) +
     (1 - (repL*mUL_cold*pU_L0 + dUL_cold) - (repL*mDL_cold*pD_L0 + dDL_cold)) : (e' = e) & (last' = A_LIGHT) & (cool' = min(cool+1,CMAX));

  // warm zone (two cases merged via same formula style)
  [light] e>0 & e<L & zWARM & !(last = A_LIGHT) ->
     (mUL_warm*pU_L0 + dUL_warm) : (e' = min(e+1,L)) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX)) +
     (mDL_warm*pD_L0 + dDL_warm) : (e' = max(e-1,0)) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX)) +
     (1 - (mUL_warm*pU_L0 + dUL_warm) - (mDL_warm*pD_L0 + dDL_warm)) : (e'=e) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX));

  [light] e>0 & e<L & zWARM & (last = A_LIGHT) ->
     (repL*mUL_warm*pU_L0 + dUL_warm) : (e' = min(e+1,L)) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX)) +
     (repL*mDL_warm*pD_L0 + dDL_warm) : (e' = max(e-1,0)) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX)) +
     (1 - (repL*mUL_warm*pU_L0 + dUL_warm) - (repL*mDL_warm*pD_L0 + dDL_warm)) : (e'=e) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX));

  // hot zone
  [light] e>0 & e<L & zHOT & !(last = A_LIGHT) ->
     (mUL_hot*pU_L0 + dUL_hot) : (e' = min(e+1,L)) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX)) +
     (mDL_hot*pD_L0 + dDL_hot) : (e' = max(e-1,0)) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX)) +
     (1 - (mUL_hot*pU_L0 + dUL_hot) - (mDL_hot*pD_L0 + dDL_hot)) : (e'=e) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX));

  [light] e>0 & e<L & zHOT & (last = A_LIGHT) ->
     (repL*mUL_hot*pU_L0 + dUL_hot) : (e' = min(e+1,L)) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX)) +
     (repL*mDL_hot*pD_L0 + dDL_hot) : (e' = max(e-1,0)) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX)) +
     (1 - (repL*mUL_hot*pU_L0 + dUL_hot) - (repL*mDL_hot*pD_L0 + dDL_warm)) : (e'=e) & (last'=A_LIGHT) & (cool'=min(cool+1,CMAX));

  // ---------- MEDIUM ----------
  [medium] e>0 & e<L & zCOLD & !(last = A_MED) ->
     (mUM_cold*pU_M0 + dUM_cold) : (e'=min(e+1,L)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (mDM_cold*pD_M0 + dDM_cold) : (e'=max(e-1,0)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (1 - (mUM_cold*pU_M0 + dUM_cold) - (mDM_cold*pD_M0 + dDM_cold)) : (e'=e) & (last'=A_MED) & (cool'=min(cool+1,CMAX));

  [medium] e>0 & e<L & zCOLD & (last = A_MED) ->
     (repM*mUM_cold*pU_M0 + dUM_cold) : (e'=min(e+1,L)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (repM*mDM_cold*pD_M0 + dDM_cold) : (e'=max(e-1,0)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (1 - (repM*mUM_cold*pU_M0 + dUM_cold) - (repM*mDM_cold*pD_M0 + dDM_cold)) : (e'=e) & (last'=A_MED) & (cool'=min(cool+1,CMAX));

  [medium] e>0 & e<L & zWARM & !(last = A_MED) ->
     (mUM_warm*pU_M0 + dUM_warm) : (e'=min(e+1,L)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (mDM_warm*pD_M0 + dDM_warm) : (e'=max(e-1,0)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (1 - (mUM_warm*pU_M0 + dUM_warm) - (mDM_warm*pD_M0 + dDM_warm)) : (e'=e) & (last'=A_MED) & (cool'=min(cool+1,CMAX));

  [medium] e>0 & e<L & zWARM & (last = A_MED) ->
     (repM*mUM_warm*pU_M0 + dUM_warm) : (e'=min(e+1,L)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (repM*mDM_warm*pD_M0 + dDM_warm) : (e'=max(e-1,0)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (1 - (repM*mUM_warm*pU_M0 + dUM_warm) - (repM*mDM_warm*pD_M0 + dDM_warm)) : (e'=e) & (last'=A_MED) & (cool'=min(cool+1,CMAX));

  [medium] e>0 & e<L & zHOT & !(last = A_MED) ->
     (mUM_hot*pU_M0 + dUM_hot) : (e'=min(e+1,L)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (mDM_hot*pD_M0 + dDM_hot) : (e'=max(e-1,0)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (1 - (mUM_hot*pU_M0 + dUM_hot) - (mDM_hot*pD_M0 + dDM_hot)) : (e'=e) & (last'=A_MED) & (cool'=min(cool+1,CMAX));

  [medium] e>0 & e<L & zHOT & (last = A_MED) ->
     (repM*mUM_hot*pU_M0 + dUM_hot) : (e'=min(e+1,L)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (repM*mDM_hot*pD_M0 + dDM_hot) : (e'=max(e-1,0)) & (last'=A_MED) & (cool'=min(cool+1,CMAX)) +
     (1 - (repM*mUM_hot*pU_M0 + dUM_hot) - (repM*mDM_hot*pD_M0 + dDM_hot)) : (e'=e) & (last'=A_MED) & (cool'=min(cool+1,CMAX));

  // ---------- AGGRESSIVE ----------
  // cooldown<CMAX ⇒ extra penalty via coolA multiplier on BOTH up/down (more volatility)
  [aggr] e>0 & e<L & zCOLD & !(last = A_AGGR) & (cool < CMAX) ->
     (coolA*mUA_cold*pU_A0 + dUA_cold) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (coolA*mDA_cold*pD_A0 + dDA_cold) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (coolA*mUA_cold*pU_A0 + dUA_cold) - (coolA*mDA_cold*pD_A0 + dDA_cold)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  [aggr] e>0 & e<L & zCOLD & !(last = A_AGGR) & (cool = CMAX) ->
     (mUA_cold*pU_A0 + dUA_cold) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (mDA_cold*pD_A0 + dDA_cold) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (mUA_cold*pU_A0 + dUA_cold) - (mDA_cold*pD_A0 + dDA_cold)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  [aggr] e>0 & e<L & zCOLD & (last = A_AGGR) & (cool < CMAX) ->
     (repA*coolA*mUA_cold*pU_A0 + dUA_cold) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (repA*coolA*mDA_cold*pD_A0 + dDA_cold) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (repA*coolA*mUA_cold*pU_A0 + dUA_cold) - (repA*coolA*mDA_cold*pD_A0 + dDA_cold)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  [aggr] e>0 & e<L & zCOLD & (last = A_AGGR) & (cool = CMAX) ->
     (repA*mUA_cold*pU_A0 + dUA_cold) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (repA*mDA_cold*pD_A0 + dDA_cold) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (repA*mUA_cold*pU_A0 + dUA_cold) - (repA*mDA_cold*pD_A0 + dDA_cold)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  // WARM
  [aggr] e>0 & e<L & zWARM & !(last = A_AGGR) & (cool < CMAX) ->
     (coolA*mUA_warm*pU_A0 + dUA_warm) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (coolA*mDA_warm*pD_A0 + dDA_warm) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (coolA*mUA_warm*pU_A0 + dUA_warm) - (coolA*mDA_warm*pD_A0 + dDA_warm)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  [aggr] e>0 & e<L & zWARM & !(last = A_AGGR) & (cool = CMAX) ->
     (mUA_warm*pU_A0 + dUA_warm) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (mDA_warm*pD_A0 + dDA_warm) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (mUA_warm*pU_A0 + dUA_warm) - (mDA_warm*pD_A0 + dDA_warm)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  [aggr] e>0 & e<L & zWARM & (last = A_AGGR) & (cool < CMAX) ->
     (repA*coolA*mUA_warm*pU_A0 + dUA_warm) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (repA*coolA*mDA_warm*pD_A0 + dDA_warm) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (repA*coolA*mUA_warm*pU_A0 + dUA_warm) - (repA*coolA*mDA_warm*pD_A0 + dDA_warm)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  [aggr] e>0 & e<L & zWARM & (last = A_AGGR) & (cool = CMAX) ->
     (repA*mUA_warm*pU_A0 + dUA_warm) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (repA*mDA_warm*pD_A0 + dDA_warm) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (repA*mUA_warm*pU_A0 + dUA_warm) - (repA*mDA_warm*pD_A0 + dDA_warm)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  // HOT
  [aggr] e>0 & e<L & zHOT & !(last = A_AGGR) & (cool < CMAX) ->
     (coolA*mUA_hot*pU_A0 + dUA_hot) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (coolA*mDA_hot*pD_A0 + dDA_hot) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (coolA*mUA_hot*pU_A0 + dUA_hot) - (coolA*mDA_hot*pD_A0 + dDA_hot)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  [aggr] e>0 & e<L & zHOT & !(last = A_AGGR) & (cool = CMAX) ->
     (mUA_hot*pU_A0 + dUA_hot) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (mDA_hot*pD_A0 + dDA_hot) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (mUA_hot*pU_A0 + dUA_hot) - (mDA_hot*pD_A0 + dDA_hot)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  [aggr] e>0 & e<L & zHOT & (last = A_AGGR) & (cool < CMAX) ->
     (repA*coolA*mUA_hot*pU_A0 + dUA_hot) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (repA*coolA*mDA_hot*pD_A0 + dDA_hot) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (repA*coolA*mUA_hot*pU_A0 + dUA_hot) - (repA*coolA*mDA_hot*pD_A0 + dDA_hot)) : (e'=e) & (last'=A_AGGR) & (cool'=0);

  [aggr] e>0 & e<L & zHOT & (last = A_AGGR) & (cool = CMAX) ->
     (repA*mUA_hot*pU_A0 + dUA_hot) : (e'=min(e+1,L)) & (last'=A_AGGR) & (cool'=0) +
     (repA*mDA_hot*pD_A0 + dDA_hot) : (e'=max(e-1,0)) & (last'=A_AGGR) & (cool'=0) +
     (1 - (repA*mUA_hot*pU_A0 + dUA_hot) - (repA*mDA_hot*pD_A0 + dDA_hot)) : (e'=e) & (last'=A_AGGR) & (cool'=0);
endmodule

// ===== Rewards: time+action costs; churn per step =====
rewards "eng_cost"
  (e>0 & e<L) : time_cost;
  [light]  true : cost_light;
  [medium] true : cost_med;
  [aggr]   true : cost_aggr;
  (e=0) : churn_pen;
endrewards