ta68*(L0_68 + L1_68*xSc) + theta69*(L0_69 + L1_69*xSc) + theta70*(L0_70 + L1_70*xSc) + theta71*(L0_71 + L1_71*xSc) + theta72*(L0_72 + L1_72*xSc) + theta73*(L0_73 + L1_73*xSc) + theta74*(L0_74 + L1_74*xSc) + theta75*(L0_75 + L1_75*xSc) + theta76*(L0_76 + L1_76*xSc) + theta77*(L0_77 + L1_77*xSc) + theta78*(L0_78 + L1_78*xSc) + theta79*(L0_79 + L1_79*xSc) + theta80*(L0_80 + L1_80*xSc) + theta81*(L0_81 + L1_81*xSc) + theta82*(L0_82 + L1_82*xSc) + theta83*(L0_83 + L1_83*xSc) + theta84*(L0_84 + L1_84*xSc) + theta85*(L0_85 + L1_85*xSc) + theta86*(L0_86 + L1_86*xSc) + theta87*(L0_87 + L1_87*xSc) + theta88*(L0_88 + L1_88*xSc) + theta89*(L0_89 + L1_89*xSc) + theta90*(L0_90 + L1_90*xSc) + theta91*(L0_91 + L1_91*xSc) + theta92*(L0_92 + L1_92*xSc) + theta93*(L0_93 + L1_93*xSc) + theta94*(L0_94 + L1_94*xSc) + theta95*(L0_95 + L1_95*xSc) + theta96*(L0_96 + L1_96*xSc) + theta97*(L0_97 + L1_97*xSc) + theta98*(L0_98 + L1_98*xSc) + theta99*(L0_99 + L1_99*xSc) + theta100*(L0_100 + L1_100*xSc);
formula sH0 = theta1*(H0_1 + H1_1*ySc) + theta2*(H0_2 + H1_2*ySc) + theta3*(H0_3 + H1_3*ySc) + theta4*(H0_4 + H1_4*ySc) + theta5*(H0_5 + H1_5*ySc) + theta6*(H0_6 + H1_6*ySc) + theta7*(H0_7 + H1_7*ySc) + theta8*(H0_8 + H1_8*ySc) + theta9*(H0_9 + H1_9*ySc) + theta10*(H0_10 + H1_10*ySc) + theta11*(H0_11 + H1_11*ySc) + theta12*(H0_12 + H1_12*ySc) + theta13*(H0_13 + H1_13*ySc) + theta14*(H0_14 + H1_14*ySc) + theta15*(H0_15 + H1_15*ySc) + theta16*(H0_16 + H1_16*ySc) + theta17*(H0_17 + H1_17*ySc) + theta18*(H0_18 + H1_18*ySc) + theta19*(H0_19 + H1_19*ySc) + theta20*(H0_20 + H1_20*ySc) + theta21*(H0_21 + H1_21*ySc) + theta22*(H0_22 + H1_22*ySc) + theta23*(H0_23 + H1_23*ySc) + theta24*(H0_24 + H1_24*ySc) + theta25*(H0_25 + H1_25*ySc) + theta26*(H0_26 + H1_26*ySc) + theta27*(H0_27 + H1_27*ySc) + theta28*(H0_28 + H1_28*ySc) + theta29*(H0_29 + H1_29*ySc) + theta30*(H0_30 + H1_30*ySc) + theta31*(H0_31 + H1_31*ySc) + theta32*(H0_32 + H1_32*ySc) + theta33*(H0_33 + H1_33*ySc) + theta34*(H0_34 + H1_34*ySc) + theta35*(H0_35 + H1_35*ySc) + theta36*(H0_36 + H1_36*ySc) + theta37*(H0_37 + H1_37*ySc) + theta38*(H0_38 + H1_38*ySc) + theta39*(H0_39 + H1_39*ySc) + theta40*(H0_40 + H1_40*ySc) + theta41*(H0_41 + H1_41*ySc) + theta42*(H0_42 + H1_42*ySc) + theta43*(H0_43 + H1_43*ySc) + theta44*(H0_44 + H1_44*ySc) + theta45*(H0_45 + H1_45*ySc) + theta46*(H0_46 + H1_46*ySc) + theta47*(H0_47 + H1_47*ySc) + theta48*(H0_48 + H1_48*ySc) + theta49*(H0_49 + H1_49*ySc) + theta50*(H0_50 + H1_50*ySc) + theta51*(H0_51 + H1_51*ySc) + theta52*(H0_52 + H1_52*ySc) + theta53*(H0_53 + H1_53*ySc) + theta54*(H0_54 + H1_54*ySc) + theta55*(H0_55 + H1_55*ySc) + theta56*(H0_56 + H1_56*ySc) + theta57*(H0_57 + H1_57*ySc) + theta58*(H0_58 + H1_58*ySc) + theta59*(H0_59 + H1_59*ySc) + theta60*(H0_60 + H1_60*ySc) + theta61*(H0_61 + H1_61*ySc) + theta62*(H0_62 + H1_62*ySc) + theta63*(H0_63 + H1_63*ySc) + theta64*(H0_64 + H1_64*ySc) + theta65*(H0_65 + H1_65*ySc) + theta66*(H0_66 + H1_66*ySc) + theta67*(H0_67 + H1_67*ySc) + theta68*(H0_68 + H1_68*ySc) + theta69*(H0_69 + H1_69*ySc) + theta70*(H0_70 + H1_70*ySc) + theta71*(H0_71 + H1_71*ySc) + theta72*(H0_72 + H1_72*ySc) + theta73*(H0_73 + H1_73*ySc) + theta74*(H0_74 + H1_74*ySc) + theta75*(H0_75 + H1_75*ySc) + theta76*(H0_76 + H1_76*ySc) + theta77*(H0_77 + H1_77*ySc) + theta78*(H0_78 + H1_78*ySc) + theta79*(H0_79 + H1_79*ySc) + theta80*(H0_80 + H1_80*ySc) + theta81*(H0_81 + H1_81*ySc) + theta82*(H0_82 + H1_82*ySc) + theta83*(H0_83 + H1_83*ySc) + theta84*(H0_84 + H1_84*ySc) + theta85*(H0_85 + H1_85*ySc) + theta86*(H0_86 + H1_86*ySc) + theta87*(H0_87 + H1_87*ySc) + theta88*(H0_88 + H1_88*ySc) + theta89*(H0_89 + H1_89*ySc) + theta90*(H0_90 + H1_90*ySc) + theta91*(H0_91 + H1_91*ySc) + theta92*(H0_92 + H1_92*ySc) + theta93*(H0_93 + H1_93*ySc) + theta94*(H0_94 + H1_94*ySc) + theta95*(H0_95 + H1_95*ySc) + theta96*(H0_96 + H1_96*ySc) + theta97*(H0_97 + H1_97*ySc) + theta98*(H0_98 + H1_98*ySc) + theta99*(H0_99 + H1_99*ySc) + theta100*(H0_100 + H1_100*ySc);

// ===== ADAPTIVE ZONES =====
// 3×3 column/row bands
formula zW = (xLoc <= 4);
formula zC = (xLoc >= 5 & xLoc <= 8);
formula zE = (xLoc >= 9);

formula zS = (yLoc <= 4);
formula zM = (yLoc >= 5 & yLoc <= 8);
formula zN = (yLoc >= 9);

// jam rectangles (two per band)
formula jamL = (xLoc >= 3 & xLoc <= 6 & yLoc >= 9 & yLoc <= 12)
             | (xLoc >= 8 & xLoc <= 12 & yLoc >= 6 & yLoc <= 8);
formula jamH = (xLoc >= 2 & xLoc <= 5 & yLoc >= 3 & yLoc <= 6)
             | (xLoc >= 7 & xLoc <= 10 & yLoc >= 2 & yLoc <= 4);

// per-zone multipliers (kept ≤~1.55 so probs stay < 1 after scaling)
const double mL_WS = 0.85;
const double mL_WM = 0.95;
const double mL_WN = 0.75;
const double mL_CS = 1.10;
const double mL_CM = 1.55;
const double mL_CN = 1.00;
const double mL_ES = 0.90;
const double mL_EM = 1.20;
const double mL_EN = 1.05;

const double mH_WS = 0.85;
const double mH_WM = 1.20;
const double mH_WN = 0.95;
const double mH_CS = 0.90;
const double mH_CM = 1.50;
const double mH_CN = 1.10;
const double mH_ES = 0.80;
const double mH_EM = 1.25;
const double mH_EN = 1.00;

const double jL = 0.60;   // low-band jam factor
const double jH = 0.60;   // high-band jam factor

// ===== ROBOT DYNAMICS =====
module robot
  xLoc : [1..Xsize] init 1;
  yLoc : [1..Ysize] init 1;

  unreported : [0..B] init 0;      // steps since last successful send
  hasSendNow : bool init false;    // just sent successfully
  tries : [0..MAXTRIES] init 0;    // consecutive failed send attempts

  // movement (reset unreported only right after a success)
  [up]    xLoc < Xsize & !T & hasSendNow  -> 1 : (xLoc'=xLoc+1) & (unreported'=0) & (hasSendNow'=false);
  [up]    xLoc < Xsize & !T & !hasSendNow -> 1 : (xLoc'=xLoc+1) & (unreported'=min(unreported+1,B));

  [right] yLoc < Ysize & !T & hasSendNow  -> 1 : (yLoc'=yLoc+1) & (unreported'=0) & (hasSendNow'=false);
  [right] yLoc < Ysize & !T & !hasSendNow -> 1 : (yLoc'=yLoc+1) & (unreported'=min(unreported+1,B));

  // ---------- sendL: 3×3 zones × {jam, !jam} ----------
  // west-south
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zW & zS & jamL ->
     jL*mL_WS*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jL*mL_WS*sL0) : (tries'=tries+1);
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zW & zS & !jamL ->
     mL_WS*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mL_WS*sL0) : (tries'=tries+1);

  // west-middle
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zW & zM & jamL ->
     jL*mL_WM*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jL*mL_WM*sL0) : (tries'=tries+1);
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zW & zM & !jamL ->
     mL_WM*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mL_WM*sL0) : (tries'=tries+1);

  // west-north
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zW & zN & jamL ->
     jL*mL_WN*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jL*mL_WN*sL0) : (tries'=tries+1);
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zW & zN & !jamL ->
     mL_WN*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mL_WN*sL0) : (tries'=tries+1);

  // centre-south
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zC & zS & jamL ->
     jL*mL_CS*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jL*mL_CS*sL0) : (tries'=tries+1);
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zC & zS & !jamL ->
     mL_CS*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mL_CS*sL0) : (tries'=tries+1);

  // centre-middle
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zC & zM & jamL ->
     jL*mL_CM*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jL*mL_CM*sL0) : (tries'=tries+1);
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zC & zM & !jamL ->
     mL_CM*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mL_CM*sL0) : (tries'=tries+1);

  // centre-north
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zC & zN & jamL ->
     jL*mL_CN*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jL*mL_CN*sL0) : (tries'=tries+1);
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zC & zN & !jamL ->
     mL_CN*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mL_CN*sL0) : (tries'=tries+1);

  // east-south
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zE & zS & jamL ->
     jL*mL_ES*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jL*mL_ES*sL0) : (tries'=tries+1);
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zE & zS & !jamL ->
     mL_ES*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mL_ES*sL0) : (tries'=tries+1);

  // east-middle
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zE & zM & jamL ->
     jL*mL_EM*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jL*mL_EM*sL0) : (tries'=tries+1);
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zE & zM & !jamL ->
     mL_EM*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mL_EM*sL0) : (tries'=tries+1);

  // east-north
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zE & zN & jamL ->
     jL*mL_EN*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jL*mL_EN*sL0) : (tries'=tries+1);
  [sendL] !hasSendNow & !T & tries < MAXTRIES & zE & zN & !jamL ->
     mL_EN*sL0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mL_EN*sL0) : (tries'=tries+1);

  // ---------- sendH: 3×3 zones × {jam, !jam} ----------
  // west-south
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zW & zS & jamH ->
     jH*mH_WS*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jH*mH_WS*sH0) : (tries'=tries+1);
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zW & zS & !jamH ->
     mH_WS*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mH_WS*sH0) : (tries'=tries+1);

  // west-middle
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zW & zM & jamH ->
     jH*mH_WM*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jH*mH_WM*sH0) : (tries'=tries+1);
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zW & zM & !jamH ->
     mH_WM*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mH_WM*sH0) : (tries'=tries+1);

  // west-north
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zW & zN & jamH ->
     jH*mH_WN*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jH*mH_WN*sH0) : (tries'=tries+1);
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zW & zN & !jamH ->
     mH_WN*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mH_WN*sH0) : (tries'=tries+1);

  // centre-south
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zC & zS & jamH ->
     jH*mH_CS*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jH*mH_CS*sH0) : (tries'=tries+1);
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zC & zS & !jamH ->
     mH_CS*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mH_CS*sH0) : (tries'=tries+1);

  // centre-middle
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zC & zM & jamH ->
     jH*mH_CM*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jH*mH_CM*sH0) : (tries'=tries+1);
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zC & zM & !jamH ->
     mH_CM*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mH_CM*sH0) : (tries'=tries+1);

  // centre-north
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zC & zN & jamH ->
     jH*mH_CN*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jH*mH_CN*sH0) : (tries'=tries+1);
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zC & zN & !jamH ->
     mH_CN*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mH_CN*sH0) : (tries'=tries+1);

  // east-south
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zE & zS & jamH ->
     jH*mH_ES*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jH*mH_ES*sH0) : (tries'=tries+1);
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zE & zS & !jamH ->
     mH_ES*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mH_ES*sH0) : (tries'=tries+1);

  // east-middle
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zE & zM & jamH ->
     jH*mH_EM*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jH*mH_EM*sH0) : (tries'=tries+1);
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zE & zM & !jamH ->
     mH_EM*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mH_EM*sH0) : (tries'=tries+1);

  // east-north
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zE & zN & jamH ->
     jH*mH_EN*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - jH*mH_EN*sH0) : (tries'=tries+1);
  [sendH] !hasSendNow & !T & tries < MAXTRIES & zE & zN & !jamH ->
     mH_EN*sH0 : (hasSendNow'=true) & (tries'=0)
   + (1 - mH_EN*sH0) : (tries'=tries+1);

  // goal
  [done] T -> 1 : true;
endmodule

// ===== LABELS =====
label "Target" = T;
label "Crash"  = (unreported = B);

// ===== REWARDS =====
rewards "sendbased"
  [up]    true : 0.03;
  [right] true : 0.03;
  [sendL] true : max(10, min(11 + xLoc - yLoc, 20));
  [sendH] true : min(13 + xLoc + yLoc, 24);
endrewards

rewards "sendbased_lower"
  [up]    true : 0.03;
  [right] true : 0.03;
  [sendL] true : 10;
  [sendH] true : 12;
endrewards

rewards "sendbased_upper"
  [up]    true : 0.03;
  [right] true : 0.03;
  [sendL] true : 20;
  [sendH] true : 24;
endrewards